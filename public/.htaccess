# ══════════════════════════════════════════════
# Security Headers — Santo Solar
# Compatível com Apache / HostGator / CPanel
# ══════════════════════════════════════════════

<IfModule mod_headers.c>
  # Proteção contra Clickjacking
  Header always set X-Frame-Options "DENY"

  # Bloqueia MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Desativa proteção XSS legada (CSP é mais seguro)
  Header always set X-XSS-Protection "0"

  # Reduz vazamento de URL em referências
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Desabilita APIs do browser não utilizadas
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co; frame-src 'self' https://www.canva.com https://canva.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://youtube-nocookie.com; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'"
</IfModule>

# ══════════════════════════════════════════════
# Cache de Arquivos Estáticos
# ══════════════════════════════════════════════

<IfModule mod_expires.c>
  ExpiresActive On

  # Imagens: 1 ano
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes: 1 ano
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # CSS e JS: 1 mês (Astro gera hashes nos nomes)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML: 1 hora (para refletir atualizações rápidas)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ══════════════════════════════════════════════
# Compressão GZIP
# ══════════════════════════════════════════════

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ══════════════════════════════════════════════
# Routing SPA (para subrotas do blog)
# ══════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirecionar para HTTPS (se disponível)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} santosolar\.com\.br
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirecionar www para non-www
  RewriteCond %{HTTP_HOST} ^www\.santosolar\.com\.br [NC]
  RewriteRule ^(.*)$ https://santosolar.com.br/$1 [L,R=301]
</IfModule>

# Página 404 personalizada
ErrorDocument 404 /404.html
